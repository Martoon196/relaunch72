# Relaunch72 environment — copy to .env and fill in. NEVER commit .env (see .gitignore).

# Keep development locally. Render sets production, which activates fail-closed
# secret validation and permanently disables automatic demo-account seeding.
NODE_ENV=development

# --- Anthropic API (required for live pipeline runs) ---
ANTHROPIC_API_KEY=

# Default model for all stages (Pipeline Spec v1.0: claude-sonnet-4-6 for v1)
RELAUNCH72_MODEL_DEFAULT=claude-sonnet-4-6

# Per-stage model overrides (S3/S4/S6 are quality-critical — candidates for a
# stronger model after LS-18 test-run grading). Leave empty to use the default.
RELAUNCH72_MODEL_S1=
RELAUNCH72_MODEL_S2=
RELAUNCH72_MODEL_S3=
RELAUNCH72_MODEL_S4=
RELAUNCH72_MODEL_S5=
RELAUNCH72_MODEL_S6=
RELAUNCH72_MODEL_S7=
RELAUNCH72_MODEL_S8=
RELAUNCH72_MODEL_S9=

# S0 optional LLM substantiveness check on flagged fields (off for M1; deterministic checks only)
RELAUNCH72_S0_LLM_CHECK=false

# --- Stripe payments (backend). TEST MODE ONLY until you write "go live" (hard rule #2). ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs are OPTIONAL — the server auto-provisions the four prices from the key
# on boot (idempotent). Leave blank for the auto path, or set them to pin exact
# prices (if any is set, auto-provision steps aside). `npm run stripe:setup` also
# fills these if you prefer a one-off command.
STRIPE_PRICE_AUTOPSY=
STRIPE_PRICE_CORE=
STRIPE_PRICE_CORE_BUMP=
STRIPE_PRICE_PRO=
# A production deployment using Stripe TEST mode is private by default. Set a
# random 24+ character code; the founder enters it into the browser prompt and it
# stays in sessionStorage. Never put the value in frontend code.
SANDBOX_ACCESS_TOKEN=
# Public test deployments always force mock builds. This also forces mock builds
# explicitly in local development when true.
RELAUNCH72_FORCE_MOCK_BUILDS=false
RELAUNCH72_MAX_CONCURRENT_BUILDS=4
# Recurring platform tiers are a preview. Leave false until their delivery
# services, durable jobs and fulfilment contract are implemented and verified.
PLATFORM_SUBSCRIPTIONS_ENABLED=false
# Brevo capture is off until consent/double-opt-in and shared abuse controls are
# deliberately enabled. The route returns an honest disabled response meanwhile.
PUBLIC_LEAD_CAPTURE_ENABLED=false
# Site base URL used for Stripe success/cancel redirects (the SITE, not the API):
PUBLIC_BASE_URL=http://localhost:8080
# Payments server port (Render sets PORT automatically):
PORT=4242
# Local development binds loopback by default. Any non-loopback HOST is treated
# as production and requires hardened secrets plus private sandbox access.
HOST=127.0.0.1
# Extra browser origins allowed to call the API, comma-separated. relaunch72.com,
# www.relaunch72.com and martoon196.github.io are allowed by default.
ALLOWED_ORIGINS=
# Where orders/intakes are written. On Render, point at a mounted disk (/var/data)
# for persistence across redeploys. Empty = <repo>/data.
DATA_DIR=
# Where pipeline run output (the built packs) is written. Point at the disk too
# (/var/data/runs) so builds survive redeploys and stay reviewable in /admin.
RELAUNCH72_RUNS_DIR=

# --- Admin control room (/admin) ---
# Set a random 16+ character password to enable /admin (empty = disabled). SESSION_SECRET
# signs admin + client cookies. It must be a dedicated random value of at least
# 32 characters in production; it never falls back to a Stripe secret.
ADMIN_PASSWORD=
SESSION_SECRET=

# Development demo only. These values are ignored for automatic seeding when
# NODE_ENV=production. Do not use demo credentials for a deployed service.
PORTAL_DEMO_EMAIL=
PORTAL_DEMO_PASSWORD=
PORTAL_DEMO_RUNDIR=
# Exact operator opt-in required even in local development. Never enable on a
# remotely reachable service; hardened mode ignores it.
PORTAL_DEMO_SEED=false

# --- Email delivery ---
# Postmark = transactional (the "your pack is ready" delivery send + receipts).
# `npm run deliver -- --run <dir> --to a@b.com --send` sends via Postmark; without
# --send nothing is emailed. Needs a verified sender domain in Postmark.
# The server ignores this for automatic customer messaging in test, unknown and
# currently locked live payment modes. Keep it empty on the deployed sandbox.
POSTMARK_SERVER_TOKEN=
# Public origin that serves /portal (the Render service/custom domain), with no
# path or trailing slash. Reserved for the future durable live checkout flow;
# setting it does not enable sandbox portal onboarding.
PORTAL_BASE_URL=
EMAIL_FROM=Relaunch72 <hello@relaunch72.com>
EMAIL_REPLY_TO=hello@relaunch72.com
# Brevo = marketing/nurture + onboarding sequences (contact sync → automations).
# Empty = marketing off. /api/subscribe is 503 unless public capture is explicitly
# enabled and a usable outbound provider is active; sandbox payment modes never
# forward arbitrary test-customer addresses to Brevo.
BREVO_API_KEY=
# Numeric Brevo list IDs whose automations run each sequence. Leads = scorecard
# signups (nurture); Customers = paid orders (onboarding). Empty = no list added.
BREVO_LIST_LEADS=
BREVO_LIST_CUSTOMERS=
