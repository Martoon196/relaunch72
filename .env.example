# Relaunch72 environment — copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Anthropic API (required for live pipeline runs) ---
ANTHROPIC_API_KEY=

# Default model for all stages (Pipeline Spec v1.0: claude-sonnet-4-6 for v1)
RELAUNCH72_MODEL_DEFAULT=claude-sonnet-4-6

# Per-stage model overrides (S3/S4/S6 are quality-critical — candidates for a
# stronger model after LS-18 test-run grading). Leave empty to use the default.
RELAUNCH72_MODEL_S1=
RELAUNCH72_MODEL_S2=
RELAUNCH72_MODEL_S3=
RELAUNCH72_MODEL_S4=
RELAUNCH72_MODEL_S5=
RELAUNCH72_MODEL_S6=
RELAUNCH72_MODEL_S7=
RELAUNCH72_MODEL_S8=
RELAUNCH72_MODEL_S9=

# S0 optional LLM substantiveness check on flagged fields (off for M1; deterministic checks only)
RELAUNCH72_S0_LLM_CHECK=false

# --- Stripe payments (backend). TEST MODE ONLY until you write "go live" (hard rule #2). ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs are created and filled in for you by:  npm run stripe:setup
# (leave blank — the command provisions the products and writes them here).
STRIPE_PRICE_AUTOPSY=
STRIPE_PRICE_CORE=
STRIPE_PRICE_CORE_BUMP=
STRIPE_PRICE_PRO=
# Site base URL used for Stripe success/cancel redirects (the SITE, not the API):
PUBLIC_BASE_URL=http://localhost:8080
# Payments server port (Render sets PORT automatically):
PORT=4242
# Extra browser origins allowed to call the API, comma-separated. relaunch72.com,
# www.relaunch72.com and martoon196.github.io are allowed by default.
ALLOWED_ORIGINS=
# Where orders/intakes are written. On Render, point at a mounted disk (/var/data)
# for persistence across redeploys. Empty = <repo>/data.
DATA_DIR=

# --- Email delivery (later) ---
# Brevo = marketing/nurture sequences. Postmark = transactional (delivery, receipts).
BREVO_API_KEY=
POSTMARK_SERVER_TOKEN=
