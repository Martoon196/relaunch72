# Relaunch72 environment — copy to .env and fill in. NEVER commit .env (see .gitignore).

# Keep development locally. Render sets production, which activates fail-closed
# secret validation and permanently disables automatic demo-account seeding.
NODE_ENV=development

# --- PostgreSQL foundation (not cut over to customer flows yet) ---
# Local development may use one DATABASE_URL. Production deliberately rejects
# that generic fallback: each process receives only its least-privilege role URL,
# and a new pool connection verifies its actual PostgreSQL role before checkout.
DATABASE_URL=
DATABASE_MIGRATOR_URL=
DATABASE_WEB_URL=
DATABASE_IDENTITY_COMMAND_URL=
DATABASE_ABUSE_COMMAND_URL=
DATABASE_PROVISIONING_COMMAND_URL=
DATABASE_SETUP_DELIVERY_COMMAND_URL=
DATABASE_SETUP_REISSUE_COMMAND_URL=
DATABASE_CRM_COMMAND_URL=
DATABASE_CONTENT_COMMAND_URL=
DATABASE_EXTERNAL_EVENT_COMMAND_URL=
DATABASE_OWNED_SOCIAL_WORKER_URL=
DATABASE_WORKER_URL=
DATABASE_WEBHOOK_URL=
DATABASE_PUBLIC_URL=
DATABASE_READONLY_URL=
# TLS is automatic: local loopback disables it; remote/production defaults to
# verify-full. `require` encrypts without certificate verification and must be an
# explicit deployment choice. Production never permits `disable`.
# Neon URLs may include `channel_binding=require`; the runtime maps that to
# node-postgres SCRAM channel binding. If the supplied URL says
# `sslmode=require`, set DATABASE_SSL_MODE=verify-full to require certificate
# verification as well as encrypted transport.
DATABASE_SSL_MODE=
# Optional PEM CA secret. Store real certificate material in the host secret UI.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
# Optional dedicated override for the isolated CRM command pool.
DATABASE_CRM_COMMAND_POOL_MAX=5
# Optional dedicated override for login/session commands. This credential can
# execute only the audited portal identity functions; it has no table grants.
DATABASE_IDENTITY_COMMAND_POOL_MAX=3
# Function-only distributed portal admission. Production uses a dedicated
# NOINHERIT role, a two-connection pool and a one-second statement ceiling.
DATABASE_ABUSE_COMMAND_POOL_MAX=2
DATABASE_ABUSE_COMMAND_STATEMENT_TIMEOUT_MS=1000
# Optional dedicated override for atomic organisation/workspace onboarding.
# This role can execute only the audited provisioning function.
DATABASE_PROVISIONING_COMMAND_POOL_MAX=3
# Optional dedicated overrides for the encrypted setup-link delivery worker and
# trusted/operator reissue command. Neither role has direct table privileges.
DATABASE_SETUP_DELIVERY_COMMAND_POOL_MAX=2
DATABASE_SETUP_REISSUE_COMMAND_POOL_MAX=2
# Receipt-only Property Predator ingress pool. Its login has no table grants.
DATABASE_EXTERNAL_EVENT_COMMAND_POOL_MAX=3
# Function-only 0052 owned-profile social worker. It receives no web, command,
# owner or migrator identity and processes at most one job at a time.
DATABASE_OWNED_SOCIAL_WORKER_POOL_MAX=1
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Property Predator external-event shadow bridge ---
# Disabled by default. When enabled, POST /api/external-events/v1/property-predator
# authenticates and journals immutable shadow receipts only: it cannot create or
# update CRM records, conversion journeys, consent, or outbox work. Production
# also requires HTTPS. DATABASE_EXTERNAL_EVENT_COMMAND_URL must authenticate as
# r72_external_event_command; this bridge never uses DATABASE_WEBHOOK_URL or
# falls back to DATABASE_URL when explicitly enabled.
PROPERTY_PREDATOR_EXTERNAL_EVENTS_ENABLED=false
# Production requires a genuinely encrypted socket by default. If TLS ends at a
# reverse proxy, list the exact comma-separated socket peer IP addresses here.
# X-Forwarded-Proto is ignored for every other peer. Do not enter hostnames or
# broad network ranges; leave empty when Node terminates TLS itself.
PROPERTY_PREDATOR_EXTERNAL_EVENTS_TRUSTED_PROXY_ADDRESSES=
# Public identifier for the dedicated signing key. Sent as X-R72-Key-Id.
PROPERTY_PREDATOR_EXTERNAL_EVENTS_KEY_ID=
# Trusted server-side tenant mapping. No workspace/profile value is accepted
# from the event body.
PROPERTY_PREDATOR_EXTERNAL_EVENTS_WORKSPACE_ID=
# Canonical unpadded base64url encoding of 32-1024 random bytes. Generate a new
# dedicated secret: never reuse Stripe, session, database, email, or API keys.
PROPERTY_PREDATOR_EXTERNAL_EVENTS_HMAC_SECRET_BASE64URL=
# Integration tests can create/truncate identity fixtures. This must name an
# explicitly disposable database containing a standalone `test` segment (for
# example relaunch72_test) on a fresh isolated branch/project. Use Neon's direct
# URL, never its `-pooler` hostname. Normal tests skip it when this is empty; the
# explicit integration command fails rather than reporting a false green.
TEST_DATABASE_URL=
TEST_DATABASE_SSL_MODE=
# Required exact acknowledgement for the destructive integration suite. Use
# only on a fresh isolated Neon branch/project; migrations also alter roles,
# which are wider than one database on the branch.
TEST_DATABASE_RESET_CONFIRM=

# --- Anthropic API (required for live pipeline runs) ---
ANTHROPIC_API_KEY=

# Default model for all stages (Pipeline Spec v1.0: claude-sonnet-4-6 for v1)
RELAUNCH72_MODEL_DEFAULT=claude-sonnet-4-6

# Per-stage model overrides (S3/S4/S6 are quality-critical — candidates for a
# stronger model after LS-18 test-run grading). Leave empty to use the default.
RELAUNCH72_MODEL_S1=
RELAUNCH72_MODEL_S2=
RELAUNCH72_MODEL_S3=
RELAUNCH72_MODEL_S4=
RELAUNCH72_MODEL_S5=
RELAUNCH72_MODEL_S6=
RELAUNCH72_MODEL_S7=
RELAUNCH72_MODEL_S8=
RELAUNCH72_MODEL_S9=

# S0 optional LLM substantiveness check on flagged fields (off for M1; deterministic checks only)
RELAUNCH72_S0_LLM_CHECK=false

# --- Stripe payments (backend). TEST MODE ONLY until you write "go live" (hard rule #2). ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs are OPTIONAL — the server auto-provisions the four prices from the key
# on boot (idempotent). Leave blank for the auto path, or set them to pin exact
# prices (if any is set, auto-provision steps aside). `npm run stripe:setup` also
# fills these if you prefer a one-off command.
STRIPE_PRICE_AUTOPSY=
STRIPE_PRICE_CORE=
STRIPE_PRICE_CORE_BUMP=
STRIPE_PRICE_PRO=
# A production deployment using Stripe TEST mode is private by default. Set a
# random 24+ character code; the founder enters it into the browser prompt and it
# stays in sessionStorage. Never put the value in frontend code.
SANDBOX_ACCESS_TOKEN=
# Public test deployments always force mock builds. This also forces mock builds
# explicitly in local development when true.
RELAUNCH72_FORCE_MOCK_BUILDS=false
RELAUNCH72_MAX_CONCURRENT_BUILDS=4
# Recurring platform tiers are a preview. Leave false until their delivery
# services, durable jobs and fulfilment contract are implemented and verified.
PLATFORM_SUBSCRIPTIONS_ENABLED=false
# Brevo capture is off until consent/double-opt-in and shared abuse controls are
# deliberately enabled. The route returns an honest disabled response meanwhile.
PUBLIC_LEAD_CAPTURE_ENABLED=false
# Site base URL used for Stripe success/cancel redirects (the SITE, not the API):
PUBLIC_BASE_URL=http://localhost:8080
# Payments server port (Render sets PORT automatically):
PORT=4242
# Local development binds loopback by default. Any non-loopback HOST is treated
# as production and requires hardened secrets plus private sandbox access.
HOST=127.0.0.1
# Extra browser origins allowed to call the API, comma-separated. relaunch72.com,
# www.relaunch72.com and martoon196.github.io are allowed by default.
ALLOWED_ORIGINS=
# Where orders/intakes are written. On Render, point at a mounted disk (/var/data)
# for persistence across redeploys. Empty = <repo>/data.
DATA_DIR=
# Where pipeline run output (the built packs) is written. Point at the disk too
# (/var/data/runs) so builds survive redeploys and stay reviewable in /admin.
RELAUNCH72_RUNS_DIR=

# --- Admin control room (/admin) ---
# Set a random 16+ character password to enable /admin (empty = disabled).
# Production admin access also requires a 32-128 character RFC 4648 base32 TOTP
# setup key and a positive, operator-owned session epoch. Increment the epoch
# to revoke every existing admin cookie; never let a deployment manifest reset
# it. Configure the same TOTP key in the founder's authenticator and Render.
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_EPOCH=
# SESSION_SECRET signs admin + client cookies. It must be a dedicated random
# value of at least 32 characters in production; it never falls back to Stripe.
SESSION_SECRET=
# Independent HMAC key for low-entropy abuse evidence. Never reuse SESSION_SECRET.
PORTAL_ABUSE_HASH_SECRET=
# Production Growth HQ accepts only `render` and derives source authority solely
# from one valid CF-Connecting-IP value; X-Forwarded-For is never authoritative.
# Local development defaults to the explicit direct-peer resolver.
PORTAL_PROXY_MODE=direct

# Development demo only. These values are ignored for automatic seeding when
# NODE_ENV=production. Do not use demo credentials for a deployed service.
PORTAL_DEMO_EMAIL=
PORTAL_DEMO_PASSWORD=
PORTAL_DEMO_RUNDIR=
# Exact operator opt-in required even in local development. Never enable on a
# remotely reachable service; hardened mode ignores it.
PORTAL_DEMO_SEED=false
# Explicit cutover gate. When true, the always-on portal requires a current
# PostgreSQL schema plus r72_web, r72_identity_command, r72_abuse_command and r72_crm_command
# connections. Native onboarding is a separately composed fail-closed process
# using the provisioning, setup-delivery and setup-reissue identities above.
# It never silently falls back to tenant-bearing legacy cookies on failure.
PORTAL_POSTGRES_ENABLED=false
# Trusted presentation profile for the canonical portal. This changes branding,
# labels and blueprint previews only; it cannot grant permissions or providers.
# Allowed: relaunch72 | property_predator_growth
PORTAL_PRODUCT_PROFILE=relaunch72

# Optional Property Predator → Growth HQ shared sign-in. Disabled means the
# routes/buttons are not composed and password login remains available. When
# enabled, all URLs, client values and the founder bootstrap pair are required.
# The backchannel returns only a short-lived verified identity assertion; no
# main-site JWT, refresh token or Google credential is retained by Growth HQ.
PROPERTY_PREDATOR_SSO_ENABLED=false
PROPERTY_PREDATOR_SSO_ISSUER=https://propertypredator.com
PROPERTY_PREDATOR_SSO_AUTHORIZE_URL=https://propertypredator.com/sso.html
PROPERTY_PREDATOR_SSO_TOKEN_URL=https://propertypredator.com/api/auth/sso/token
PROPERTY_PREDATOR_SSO_CLIENT_ID=
PROPERTY_PREDATOR_SSO_CLIENT_SECRET=
PROPERTY_PREDATOR_SSO_REDIRECT_URI=http://127.0.0.1:4242/portal/auth/property-predator/callback
# Optional first-link pair. Set both or neither. The UUID is an already-created
# HQ user; the comma-separated allowlist contains verified main-site emails
# permitted to bind that user once. Canonical HQ contact email stays unchanged.
PROPERTY_PREDATOR_SSO_BOOTSTRAP_USER_ID=
PROPERTY_PREDATOR_SSO_BOOTSTRAP_EMAILS=

# --- Property Predator controlled live-pilot preflight ---
# `npm run pilot:preflight` performs configuration-shape checks only. It makes
# no database/provider calls, sends nothing and never prints these values.
# For a Property Predator deployment, replace the earlier generic setting with
# PORTAL_PRODUCT_PROFILE=property_predator_growth (do not add a duplicate key).
# The first review gate is Mailgun email to owned internal seed contacts. Every
# other rail remains optional/deferred until separately activated.
PROPERTY_PREDATOR_PILOT_WORKSPACE_ID=
PROPERTY_PREDATOR_PILOT_STAGE=internal-seed
PROPERTY_PREDATOR_PILOT_RECIPIENT_SCOPE=owned-internal-seeds-only
PROPERTY_PREDATOR_PILOT_MAX_RECIPIENTS=10
# Passing this configuration-only preflight does not authorise or technically
# prevent a live provider effect. A runtime-enforced, tested kill switch must be
# added at every live adapter composition and dispatch boundary before activation.

# Mandatory first channel — Mailgun email. Verify webhook signatures over the
# untouched provider payload before parsing or persistence.
PROPERTY_PREDATOR_EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=
MAILGUN_REGION=eu
MAILGUN_SENDING_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_EVENT_WEBHOOK_URL=
PROPERTY_PREDATOR_MAILGUN_WEBHOOK_ENABLED=false
# Signed inbound replies remain limited to the exact owned-office proof route.
# Enabling this exposes only the authenticated receive endpoint; it does not
# create a Mailgun Route and cannot send email.
PROPERTY_PREDATOR_MAILGUN_INBOUND_ENABLED=false
MAILGUN_WEBHOOK_SIGNATURE_VERIFICATION_ENABLED=false
MAILGUN_DNS_VERIFIED=false
MAILGUN_SUPPRESSION_SYNC_ENABLED=false

# Deferred rail — 360dialog WhatsApp.
PROPERTY_PREDATOR_WHATSAPP_PROVIDER=
DIALOG360_API_KEY=
DIALOG360_WABA_ID=
DIALOG360_PHONE_NUMBER_ID=
DIALOG360_WEBHOOK_URL=
DIALOG360_WEBHOOK_AUTH_SECRET=
DIALOG360_BUSINESS_VERIFIED=false

# Deferred rail — Twilio UK SMS.
PROPERTY_PREDATOR_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_UK_REGULATORY_BUNDLE_SID=
TWILIO_WEBHOOK_URL=
TWILIO_SIGNATURE_VALIDATION_ENABLED=false

# Owned-profile Ayrshare/X live foundation. The runnable worker stays dark unless
# all exact switches are reviewed together. Its AES key decrypts only the
# tenant-bound profile-key envelope stored by 0052; no plaintext profile key is
# placed in the process environment.
PROPERTY_PREDATOR_SOCIAL_PROVIDER=ayrshare
PROPERTY_PREDATOR_PUBLIC_SOCIAL_LIVE_MODE=disabled
PROPERTY_PREDATOR_PUBLIC_SOCIAL_LIVE_PROVIDER_ID=ayrshare
PROPERTY_PREDATOR_PUBLIC_SOCIAL_LIVE_NETWORK=x
PROPERTY_PREDATOR_PUBLIC_SOCIAL_LIVE_POLL_MS=5000
PROPERTY_PREDATOR_PUBLIC_SOCIAL_LIVE_WORKSPACE_ID=
PROPERTY_PREDATOR_PUBLIC_SOCIAL_LIVE_CONNECTION_ID=
PROPERTY_PREDATOR_PUBLIC_SOCIAL_PROFILE_ENCRYPTION_KEY_BASE64=
PROPERTY_PREDATOR_PUBLIC_SOCIAL_PROFILE_ENCRYPTION_KEY_VERSION=
PROPERTY_PREDATOR_PROVIDER_EFFECTS_ENABLED=false
PROPERTY_PREDATOR_SOCIAL_EMERGENCY_PAUSED=true
AYRSHARE_API_KEY=
AYRSHARE_X_OAUTH1_API_KEY=
AYRSHARE_X_OAUTH1_API_SECRET=
AYRSHARE_PROFILE_KEY=
AYRSHARE_DOMAIN_ID=
AYRSHARE_WEBHOOK_URL=
AYRSHARE_WEBHOOK_SECRET=
AYRSHARE_PROFILE_LINK_COMPLETE=false

# Deferred rail — Whereby embedded webinars.
PROPERTY_PREDATOR_WEBINAR_PROVIDER=
WHEREBY_API_KEY=
WHEREBY_WEBHOOK_URL=
WHEREBY_WEBHOOK_SECRET=
WHEREBY_ALLOWED_ORIGIN=

# Deferred rail — Nylas calendar/scheduler (EU region only for this pilot).
PROPERTY_PREDATOR_CALENDAR_PROVIDER=
NYLAS_API_KEY=
NYLAS_APPLICATION_ID=
NYLAS_REGION=eu
NYLAS_OAUTH_CALLBACK_URL=
NYLAS_WEBHOOK_URL=
NYLAS_WEBHOOK_SECRET=

# --- Email delivery ---
# Postmark = transactional (the "your pack is ready" delivery send + receipts).
# `npm run deliver -- --run <dir> --to a@b.com --send` sends via Postmark; without
# --send nothing is emailed. Needs a verified sender domain in Postmark.
# The server ignores this for automatic customer messaging in test, unknown and
# currently locked live payment modes. Keep it empty on the deployed sandbox.
POSTMARK_SERVER_TOKEN=
# Public origin that serves /portal (the Render service/custom domain), with no
# path or trailing slash. Reserved for the future durable live checkout flow;
# setting it does not enable sandbox portal onboarding.
PORTAL_BASE_URL=
# Durable native account-setup links are encrypted before entering PostgreSQL.
# The JSON maps non-secret key ids to canonical, unpadded base64url 32-byte keys.
# Keep retired keys present until startup readiness reports no claimable delivery
# still requires them. Supplying these values does not start a worker or email.
SETUP_DELIVERY_ACTIVE_KEY_ID=
SETUP_DELIVERY_KEYS_JSON=
EMAIL_FROM=Relaunch72 <hello@relaunch72.com>
EMAIL_REPLY_TO=hello@relaunch72.com
# Brevo = marketing/nurture + onboarding sequences (contact sync → automations).
# Empty = marketing off. /api/subscribe is 503 unless public capture is explicitly
# enabled and a usable outbound provider is active; sandbox payment modes never
# forward arbitrary test-customer addresses to Brevo.
BREVO_API_KEY=
# Numeric Brevo list IDs whose automations run each sequence. Leads = scorecard
# signups (nurture); Customers = paid orders (onboarding). Empty = no list added.
BREVO_LIST_LEADS=
BREVO_LIST_CUSTOMERS=
