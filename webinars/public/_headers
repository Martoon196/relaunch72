# Workers static assets headers. The embed is loaded cross-origin as ES modules,
# which browsers only allow with CORS.
/v1/embed.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/v1/embed-app.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/v1/chunks/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
