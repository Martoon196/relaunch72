index 0000000..cffb230
--- /dev/null
+++ b/app/routers/webinars.py
@@ -0,0 +1,58 @@
+"""Webinars front door: both brands' webinars listed here; every page opens in Relaunch72 through the
+sign-in handoff, so the founder signs in once (here) and never again on the brand hosts."""
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from fastapi.responses import HTMLResponse, RedirectResponse
+
+from ..auth import check_origin, require_admin
+from ..models import User
+from ..services import relaunch72_sso as sso
+from ..services.relaunch72_webinars import WebinarsUnavailable, fetch_webinars
+from ..templating import go, render
+
+router = APIRouter(dependencies=[Depends(check_origin)])
+
+OPEN_PATHS = {"list": "/portal/webinars", "new": "/portal/webinars/new", "setup": "/portal/webinars/setup"}
+
+
+def _brand(request: Request, allowed: set[str] = frozenset({"brand"})) -> str:
+    brand = request.query_params.get("brand", "mhp")
+    if brand not in sso.BRANDS or len(request.query_params.getlist("brand")) > 1 \
+            or any(key not in allowed for key in request.query_params):
+        raise HTTPException(status_code=400, detail="Choose Property Predator or Martin Howard Property")
+    return brand
+
+
+@router.get("/webinars", response_class=HTMLResponse)
+def webinars(request: Request, user: User = Depends(require_admin)):
+    brand = _brand(request)
+    try:
+        listing = fetch_webinars(brand)
+        unavailable = False
+    except WebinarsUnavailable:
+        listing = None
+        unavailable = True
+    response = render(request, "webinars.html", {
+        "user": user, "section": "webinars", "brand": brand, "brands": sso.BRANDS, "listing": listing,
+        "unavailable": unavailable, "handoff_ready": sso.configured(), "host": sso.host_for(brand),
+    })
+    response.headers["Cache-Control"] = "no-store"
+    return response
+
+
+@router.get("/webinars/open")
+def open_page(request: Request, user: User = Depends(require_admin)):
+    """303 to the brand host with a fresh two-minute token; the token exists only in this one redirect."""
+    brand = _brand(request, {"brand", "path"})
+    path = request.query_params.get("path", OPEN_PATHS["list"])
+    if len(request.query_params.getlist("path")) > 1 or not sso.valid_path(path):
+        raise HTTPException(status_code=400, detail="That is not a Relaunch72 portal page")
+    try:
+        target = sso.handoff(user.email, brand, path)
+    except sso.HandoffUnavailable:
+        return go(f"/webinars?brand={brand}", err="Sign-in handoff is not configured (R72_SSO_SECRET); open the brand host and sign in there.")
+    response = RedirectResponse(target.url, status_code=303)
+    response.headers["Cache-Control"] = "no-store"
+    response.headers["Referrer-Policy"] = "no-referrer"
+    return response
diff --git a/app/services/relaunch72_sso.py b/app/services/relaunch72_sso.py
new file mode 100644
index 0000000..94193e3
--- /dev/null
+++ b/app/services/relaunch72_sso.py
@@ -0,0 +1,96 @@
+"""Group HQ -> Relaunch72 sign-in handoff tokens.
+
+The founder is already signed in here (password + authenticator). To open a Relaunch72 portal page
+without a second login, Group HQ signs a two-minute, single-use token bound to one brand host and one
+portal path with a secret only the two web services hold. Relaunch72 verifies it at
+/portal/auth/group-hq, maps the login email to a portal user from its own server-side allowlist and
+mints its ordinary session; a token is never authority on its own and never reaches a browser as
+anything but a redirect target. The byte format mirrors orchestrator/src/portal/group-hq-sso.ts.
+"""
+from __future__ import annotations
+
+import base64
+import hmac
+import json
+import re
+import secrets
+import time
+from dataclasses import dataclass
+from hashlib import sha256
+
+from .. import config
+
+VERSION = "ghq-handoff-1"
+ROUTE = "/portal/auth/group-hq"
+LIFETIME_SECONDS = 90          # Relaunch72 accepts at most 120
+BRANDS = {"pp": "Property Predator", "mhp": "Martin Howard Property"}
+EMAIL = re.compile(r"^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$")
+# Only portal pages on the brand host: never a scheme, another host or a protocol-relative path.
+PATH = re.compile(r"^/portal(?:/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)*/?(?:\?[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?$")
+
+
+class HandoffUnavailable(Exception):
+    """The handoff is not configured, or the inputs could not be signed. Nothing was sent anywhere."""
+
+
+@dataclass(frozen=True)
+class Handoff:
+    brand: str
+    host: str
+    path: str
+    url: str
+
+
+def _b64url(raw: bytes) -> str:
+    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")
+
+
+def host_for(brand: str) -> str:
+    if brand == "pp":
+        return config.R72_PP_HOST
+    if brand == "mhp":
+        return config.R72_MHP_HOST
+    raise HandoffUnavailable()
+
+
+def valid_path(path: str) -> bool:
+    return bool(path) and len(path) <= 400 and "//" not in path and PATH.fullmatch(path) is not None
+
+
+def sign(email: str, brand: str, path: str, *, secret: str | None = None, now: float | None = None,
+         nonce: str | None = None) -> str:
+    """The exact token Relaunch72 verifies: base64url(canonical JSON) . base64url(HMAC-SHA256)."""
+    key = config.R72_SSO_SECRET if secret is None else secret
+    if not key or len(key) < 32 or len(key) > 256:
+        raise HandoffUnavailable()
+    login = (email or "").strip().lower()
+    host = host_for(brand)
+    if not EMAIL.fullmatch(login) or len(login) > 320 or not host or not valid_path(path):
+        raise HandoffUnavailable()
+    issued = int(time.time() if now is None else now)
+    claims = {"v": VERSION, "email": login, "brand": brand, "host": host, "path": path,
+              "iat": issued, "exp": issued + LIFETIME_SECONDS, "nonce": nonce or secrets.token_urlsafe(24)}
+    # Fixed key order and compact separators so both sides sign identical bytes (JSON.stringify shape).
+    body = _b64url(json.dumps(claims, separators=(",", ":"), ensure_ascii=False).encode("utf-8"))
+    mac = hmac.new(key.encode("utf-8"), b"group-hq-handoff\x00" + body.encode("ascii"), sha256).digest()
+    return f"{body}.{_b64url(mac)}"
+
+
+def handoff(email: str, brand: str, path: str, **kw) -> Handoff:
+    """A redirect target for the browser; the token lives only in that one-time URL."""
+    token = sign(email, brand, path, **kw)
+    host = host_for(brand)
+    return Handoff(brand=brand, host=host, path=path, url=f"https://{host}{ROUTE}?t={token}")
+
+
+def configured() -> bool:
+    return 32 <= len(config.R72_SSO_SECRET) <= 256
+
+
+def verify_for_tests(token: str, secret: str) -> dict:
+    """Decode a token this module signed. Tests only: Relaunch72 is the verifier in production."""
+    body, _, mac = token.partition(".")
+    expected = hmac.new(secret.encode("utf-8"), b"group-hq-handoff\x00" + body.encode("ascii"), sha256).digest()
+    if not hmac.compare_digest(_b64url(expected), mac):
+        raise HandoffUnavailable()
+    return json.loads(base64.urlsafe_b64decode(body + "=" * (-len(body) % 4)))
diff --git a/app/services/relaunch72_webinars.py b/app/services/relaunch72_webinars.py
new file mode 100644
index 0000000..fb31165
--- /dev/null
+++ b/app/services/relaunch72_webinars.py
@@ -0,0 +1,151 @@
+"""Read-only webinar listing for both brands from the host-bound Relaunch72 bridge.
+
+Relaunch72 runs the webinars (video, registration, reminders, replays, CRM handoff). Group HQ only
+lists them and opens their pages through the sign-in handoff. No product writes happen here.
+"""
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Any
+
+import httpx
+
+from .. import config
+from .relaunch72_crm import ORIGIN, UUID
+from .relaunch72_sso import BRANDS
+
+PATH = "/api/group-hq/webinars"
+KINDS = {"live": "Live", "on_demand": "On demand", "scheduled_recording": "Scheduled recording"}
+STATUSES = {"draft": "Draft", "published": "Published", "cancelled": "Cancelled", "archived": "Archived"}
+SESSIONS = {"idle", "live", "ended"}
+PUBLIC_URL = re.compile(r"^https://[a-z0-9.-]+/w/[a-z0-9][a-z0-9-]{2,70}[a-z0-9]$")
+TIMESTAMP = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?Z$")
+
+
+class WebinarsUnavailable(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class Webinar:
+    id: str
+    title: str
+    kind: str
+    status: str
+    starts_at: str | None
+    timezone: str
+    duration_minutes: int | None
+    session_state: str
+    registered: int
+    crm_linked: int
+    public_url: str | None
+    manage_path: str
+    host_path: str
+    studio_path: str
+    people_path: str
+
+    @property
+    def kind_label(self) -> str:
+        return KINDS[self.kind]
+
+    @property
+    def status_label(self) -> str:
+        return STATUSES[self.status]
+
+
+@dataclass(frozen=True)
+class WebinarListing:
+    brand: str
+    availability: str            # available | not_connected | not_available
+    workspace_name: str | None
+    webinars: tuple[Webinar, ...]
+
+
+def _text(value: Any, limit: int, *, required: bool = False) -> str | None:
+    if value is None:
+        if required:
+            raise WebinarsUnavailable()
+        return None
+    if not isinstance(value, str) or len(value) > limit or (required and not value.strip()):
+        raise WebinarsUnavailable()
+    return value
+
+
+def _count(value: Any) -> int:
+    if not isinstance(value, int) or isinstance(value, bool) or value < 0 or value > 1_000_000:
+        raise WebinarsUnavailable()
+    return value
+
+
+def _parse(payload: Any, brand: str) -> WebinarListing:
+    if not isinstance(payload, dict) or payload.get("brand") != brand:
+        raise WebinarsUnavailable()
+    availability = payload.get("availability")
+    if availability in ("not_connected", "not_available"):
+        return WebinarListing(brand, availability, None, ())
+    if availability != "available" or not isinstance(payload.get("webinars"), list) or len(payload["webinars"]) > 100:
+        raise WebinarsUnavailable()
+    workspace = payload.get("workspace")
+    if not isinstance(workspace, dict):
+        raise WebinarsUnavailable()
+    name = _text(workspace.get("name"), 200, required=True)
+    seen: set[str] = set()
+    webinars: list[Webinar] = []
+    for item in payload["webinars"]:
+        if not isinstance(item, dict) or not isinstance(item.get("id"), str) or not UUID.fullmatch(item["id"]):
+            raise WebinarsUnavailable()
+        webinar_id = item["id"].lower()
+        if webinar_id in seen:
+            raise WebinarsUnavailable()
+        seen.add(webinar_id)
+        kind, status = item.get("kind"), item.get("status")
+        if kind not in KINDS or status not in STATUSES:
+            raise WebinarsUnavailable()
+        starts_at = _text(item.get("startsAt"), 40)
+        if starts_at is not None and not TIMESTAMP.fullmatch(starts_at):
+            raise WebinarsUnavailable()
+        duration = item.get("durationMinutes")
+        if duration is not None and (not isinstance(duration, int) or isinstance(duration, bool) or duration < 0 or duration > 1440):
+            raise WebinarsUnavailable()
+        session = item.get("sessionState")
+        if session not in SESSIONS:
+            raise WebinarsUnavailable()
+        public_url = _text(item.get("publicUrl"), 400)
+        if public_url is not None and not PUBLIC_URL.fullmatch(public_url):
+            raise WebinarsUnavailable()
+        paths = item.get("paths")
+        base = f"/portal/webinars/{webinar_id}"
+        if not isinstance(paths, dict) or paths.get("manage") != base or paths.get("host") != f"{base}/host" \
+                or paths.get("studio") != f"{base}/studio" or paths.get("people") != f"{base}/people":
+            raise WebinarsUnavailable()
+        webinars.append(Webinar(
+            id=webinar_id, title=_text(item.get("title"), 200, required=True) or "", kind=kind, status=status,
+            starts_at=starts_at, timezone=_text(item.get("timezone"), 64, required=True) or "", duration_minutes=duration,
+            session_state=session, registered=_count(item.get("registered")), crm_linked=_count(item.get("crmLinked")),
+            public_url=public_url, manage_path=base, host_path=f"{base}/host", studio_path=f"{base}/studio",
+            people_path=f"{base}/people",
+        ))
+    return WebinarListing(brand, "available", name, tuple(webinars))
+
+
+def fetch_webinars(brand: str, *, client: httpx.Client | None = None, token: str | None = None) -> WebinarListing:
+    if brand not in BRANDS:
+        raise WebinarsUnavailable()
+    secret = config.R72_CRM_TOKEN if token is None else token
+    if not secret or len(secret) < 32:
+        raise WebinarsUnavailable()
+    own_client = client is None
+    http = client or httpx.Client(timeout=5.0, follow_redirects=False)
+    try:
+        response = http.get(f"{ORIGIN}{PATH}", params={"brand": brand},
+                            headers={"Authorization": f"Bearer {secret}", "Accept": "application/json",
+                                     "User-Agent": "GroupHQ/1.0"})
+        if response.status_code != 200 or len(response.content) > 200_000:
+            raise WebinarsUnavailable()
+        return _parse(response.json(), brand)
+    except (httpx.HTTPError, ValueError, TypeError) as exc:
+        raise WebinarsUnavailable() from exc
+    finally:
+        if own_client:
+            http.close()
