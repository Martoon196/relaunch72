# Secrets — never commit env files (hard rule #4)
.env
.env.*
!.env.example

# Dependencies / build
node_modules/
dist/
*.tsbuildinfo

# Pipeline run outputs (customer data lives here in production — never commit).
# Fixture demo runs for a gate review can be force-added deliberately.
runs/*
!runs/.gitkeep

# Payments backend data — paid orders + submitted customer intakes (PII). Never commit.
data/

# OS / editor noise
.DS_Store
*.log

# Licensed third-party skill source material (DigitalMarketer) — working notes only,
# must NEVER enter git history. Ports are rewritten own-IP (LS-5).
.sources/

# Webinars embed build output (npm run --workspace webinars build:embed)
webinars/public/v1/*
!webinars/public/v1/.gitkeep
webinars/.wrangler/
