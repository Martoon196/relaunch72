{
  "name": "@relaunch72/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relaunch72 pipeline orchestrator — S0 intake gate, stages S1+, QA layer, run manifests, CLI",
  "scripts": {
    "pipeline": "tsx src/cli.ts",
    "content": "tsx src/content/cli.ts",
    "social": "tsx src/social/cli.ts",
    "keyword": "tsx src/keyword/cli.ts",
    "ads": "tsx src/ads/cli.ts",
    "manager": "tsx src/manager/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
