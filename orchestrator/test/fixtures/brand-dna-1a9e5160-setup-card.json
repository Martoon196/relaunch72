round:#fff}.day.outside-month{background:#f7f8fc;color:#778094}.day h4{margin:0 0 10px;font-size:13px;color:var(--ink)}.slot{font-size:13px;padding:10px;border-radius:8px;border-left:3px solid #3557ff;margin:0 0 8px;word-break:break-word;background:#eef1ff;line-height:1.45;min-width:0}.slot a{font-weight:700;text-decoration:none}.slot.planned{background:#f8f9fc;border-color:#bcc5dc;border-left-color:#8792ae}.slot[data-editorial-proposal]{background:#fffaf0;border-left-color:#b1741a}.slot .pill{font-size:10px;padding:1px 5px;margin-top:5px}.slot small{color:var(--muted)}.slot form{display:grid;gap:6px}.slot button{padding:6px;font-size:12px;min-height:34px}.slot input{font-size:12px;padding:5px;min-width:0}.month-view .slot{padding:8px;font-size:12px;line-height:1.35}.month-view .slot p{margin:4px 0}.month-view .slot>a{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.month-view .slot p:has(small){display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.month-view .slot details{font-size:11px;margin-top:6px}.calendar-agenda{display:none}.calendar-agenda.always{display:block}.agenda-day{display:grid;grid-template-columns:100px minmax(0,1fr);gap:16px;border-bottom:1px solid var(--line);padding:18px 0}.agenda-day h3{margin:0;font-size:14px}.empty-state{padding:34px 20px;text-align:center;background:#f8f9fc;border:1px dashed #cbd2df;border-radius:12px}.empty-state h2{margin:0 0 10px}.review-note{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:10px;background:#eef1ff}.preview-url{word-break:break-all;font:13px ui-monospace,monospace}.doc-history{margin-top:8px}.section-note{font-size:13px;color:var(--muted)}\n@media(max-width:900px){.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.setup-grid{grid-template-columns:1fr}main{padding:22px}.programme-hero{padding:22px}.card{padding:18px}}\n@media(max-width:700px){main{padding:16px}.programme-hero{padding:20px;border-radius: