# Relaunch72 — environment. Copy to .env and fill in. NEVER commit .env (secrets live here only).

# ── LLM (pipeline) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides:
# RELAUNCH72_MODEL_DEFAULT=claude-sonnet-4-6
# RELAUNCH72_MODEL_S1=claude-sonnet-4-6

# ── Stripe payments (backend) ────────────────────────────────────────────────
# TEST MODE FIRST (hard rule): use sk_test_… until you deliberately go live.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create the products in your Stripe dashboard, test mode):
STRIPE_PRICE_AUTOPSY=price_...
STRIPE_PRICE_CORE=price_...
STRIPE_PRICE_CORE_BUMP=price_...
STRIPE_PRICE_PRO=price_...

# Where the site is served (used for Stripe success/cancel redirect URLs):
PUBLIC_BASE_URL=http://localhost:8080

# Payments server port:
PORT=4242
